{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "patheon-ai",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": false
  }
}
